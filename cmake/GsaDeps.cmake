# Third-party dependencies. Uses installed packages first (vcpkg on Windows, apt on Linux)
# and falls back to pinned FetchContent downloads for the header-only ones.
include(FetchContent)

find_package(nlohmann_json 3.11 QUIET)
if(NOT nlohmann_json_FOUND)
  FetchContent_Declare(json GIT_REPOSITORY https://github.com/nlohmann/json.git GIT_TAG v3.11.3 GIT_SHALLOW TRUE)
  FetchContent_MakeAvailable(json)
endif()

find_package(httplib 0.14 QUIET CONFIG)
if(NOT httplib_FOUND)
    set(HTTPLIB_REQUIRE_OPENSSL OFF CACHE BOOL "" FORCE)
    set(HTTPLIB_USE_OPENSSL_IF_AVAILABLE OFF CACHE BOOL "" FORCE)
    set(HTTPLIB_USE_BROTLI_IF_AVAILABLE OFF CACHE BOOL "" FORCE)
    set(HTTPLIB_USE_ZLIB_IF_AVAILABLE OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(httplib GIT_REPOSITORY https://github.com/yhirose/cpp-httplib.git GIT_TAG v0.18.3 GIT_SHALLOW TRUE)
    FetchContent_MakeAvailable(httplib)
endif()
find_package(Threads REQUIRED)

find_package(ZLIB REQUIRED)
if(GSA_BUILD_BACKEND)
  find_package(SQLite3 REQUIRED)
endif()

if(GSA_BUILD_TESTS)
  find_package(doctest QUIET)
  if(NOT doctest_FOUND)
    FetchContent_Declare(doctest GIT_REPOSITORY https://github.com/doctest/doctest.git GIT_TAG v2.4.11 GIT_SHALLOW TRUE)
    FetchContent_MakeAvailable(doctest)
  endif()
endif()

if(GSA_BUILD_APP)
  find_package(Vulkan REQUIRED COMPONENTS glslangValidator)
  find_package(glfw3 3.3 REQUIRED)
  find_package(protozero QUIET)
  if(NOT protozero_FOUND)
    FetchContent_Declare(protozero GIT_REPOSITORY https://github.com/mapbox/protozero.git GIT_TAG v1.7.1 GIT_SHALLOW TRUE
                         SOURCE_SUBDIR none)
    FetchContent_MakeAvailable(protozero)
    add_library(gsa_protozero INTERFACE)
    target_include_directories(gsa_protozero SYSTEM INTERFACE ${protozero_SOURCE_DIR}/include)
    add_library(protozero::protozero ALIAS gsa_protozero)
  endif()
  find_package(earcut_hpp QUIET)
  if(NOT earcut_hpp_FOUND)
    FetchContent_Declare(earcut GIT_REPOSITORY https://github.com/mapbox/earcut.hpp.git GIT_TAG v2.2.4 GIT_SHALLOW TRUE
                         SOURCE_SUBDIR none)
    FetchContent_MakeAvailable(earcut)
    add_library(gsa_earcut INTERFACE)
    target_include_directories(gsa_earcut SYSTEM INTERFACE ${earcut_SOURCE_DIR}/include)
    add_library(earcut_hpp::earcut_hpp ALIAS gsa_earcut)
  endif()
endif()
